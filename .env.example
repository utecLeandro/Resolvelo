# ============================================================================
# VARIABLES DE ENTORNO PARA RESOLVELO
# ============================================================================
# Copia este archivo como .env y configura las variables según tu entorno
# ============================================================================

# ==========================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================================================
NODE_ENV=development
PORT=3000
APP_NAME=ReSolVelo
APP_VERSION=1.0.0

# ==========================================================================
# BASE DE DATOS POSTGRESQL
# ==========================================================================
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public
DATABASE_URL=postgresql://resolvelo_user:resolvelo_password_2024@localhost:5433/resolvelo_db?schema=public

# Configuración individual (alternativa)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=resolvelo_user
DB_PASSWORD=resolvelo_password_2024
DB_DATABASE=resolvelo_db

# ==========================================================================
# REDIS PARA CACHE Y SESIONES
# ==========================================================================
REDIS_URL=redis://:resolvelo_redis_2024@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=resolvelo_redis_2024

# ==========================================================================
# AUTENTICACIÓN Y SEGURIDAD
# ==========================================================================
# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=resolvelo_jwt_secret_key_2024_super_secure_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Configuración de bcrypt para hash de contraseñas
BCRYPT_ROUNDS=12

# Configuración de rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================================================
# CONFIGURACIÓN DE CORS Y FRONTEND
# ==========================================================================
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:3001

# ==========================================================================
# CONFIGURACIÓN DE ARCHIVOS Y UPLOADS
# ==========================================================================
MAX_FILE_SIZE=10485760  # 10MB en bytes
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Configuración de AWS S3 (para producción)
AWS_REGION=us-east-1
AWS_S3_BUCKET=resolvelo-uploads
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==========================================================================
# CONFIGURACIÓN DE EMAIL
# ==========================================================================
# Para desarrollo (usando MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Para producción (ejemplo con SendGrid)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

EMAIL_FROM=noreply@resolvelo.com
EMAIL_FROM_NAME=ReSolVelo

# ==========================================================================
# CONFIGURACIÓN DE PAGOS (MOCK PARA DESARROLLO)
# ==========================================================================
PAYMENT_GATEWAY_URL=http://localhost:3000/api/mock-payments
PAYMENT_GATEWAY_KEY=mock_key_development
PAYMENT_GATEWAY_SECRET=mock_secret_development

# Para producción (ejemplo con Stripe)
# PAYMENT_GATEWAY_URL=https://api.stripe.com
# PAYMENT_GATEWAY_KEY=pk_live_your_stripe_public_key
# PAYMENT_GATEWAY_SECRET=sk_live_your_stripe_secret_key

# ==========================================================================
# SERVICIO DE VERIFICACIÓN DE USUARIOS (MOCK PARA DESARROLLO)
# ==========================================================================
VERIFICATION_SERVICE_URL=http://localhost:3000/api/mock-verification
VERIFICATION_SERVICE_KEY=mock_verification_key
VERIFICATION_SERVICE_SECRET=mock_verification_secret

# ==========================================================================
# CONFIGURACIÓN DE LOGGING
# ==========================================================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ==========================================================================
# CONFIGURACIÓN DE MONITOREO Y MÉTRICAS
# ==========================================================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==========================================================================
# CONFIGURACIÓN DE DESARROLLO
# ==========================================================================
# Habilitar modo debug
DEBUG=true

# Habilitar hot reload
HOT_RELOAD=true

# Mostrar queries de Prisma en consola
PRISMA_DEBUG=false

# ==========================================================================
# CONFIGURACIÓN DE TESTING
# ==========================================================================
TEST_DATABASE_URL=postgresql://resolvelo_user:resolvelo_password_2024@localhost:5432/resolvelo_test_db?schema=public

# ==========================================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ==========================================================================
# Configuración de SSL
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Configuración de dominio
DOMAIN=resolvelo.com
API_DOMAIN=api.resolvelo.com

# ==========================================================================
# CONFIGURACIÓN DE TERCEROS
# ==========================================================================
# Google Maps API (para geolocalización)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Servicio de notificaciones push
FIREBASE_SERVER_KEY=your_firebase_server_key

# Servicio de análisis
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# ==========================================================================
# CONFIGURACIÓN DE MERCADO PAGO (SANDBOX/PRODUCCIÓN)
# ==========================================================================
# Claves de Mercado Pago
MP_PUBLIC_KEY=TEST-cdd5b596-3912-47ad-9878-c771dfb97808
MP_ACCESS_TOKEN=TEST-2559599785005590-111615-f0b00eaf0be1e9d4ae2704483bf9d425-179955093

# URLs de redirección (usar las del frontend)
MP_SUCCESS_URL=http://localhost:5174/pago-exitoso
MP_FAILURE_URL=http://localhost:5174/pago-error
MP_PENDING_URL=http://localhost:5174/pago-exitoso

# Webhook (opcional, recomendado)
MP_NOTIFICATION_URL=http://localhost:3001/api/transacciones/mercado-pago/webhook

# Modo Sandbox
MP_SANDBOX=true