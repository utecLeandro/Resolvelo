# ============================================================================
# VARIABLES DE ENTORNO PARA RESOLVELO
# ============================================================================
# Copia este archivo como .env y configura las variables según tu entorno
# ============================================================================

# ==========================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================================================
NODE_ENV=development
PORT=3000
APP_NAME=ReSolVelo
APP_VERSION=1.0.0

# ==========================================================================
# BASE DE DATOS POSTGRESQL
# ==========================================================================
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public
DATABASE_URL=postgresql://resolvelo_user:resolvelo_password_2024@localhost:5433/resolvelo_db?schema=public

# Configuración individual (alternativa)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=resolvelo_user
DB_PASSWORD=resolvelo_password_2024
DB_DATABASE=resolvelo_db

# ==========================================================================
# REDIS PARA CACHE Y SESIONES
# ==========================================================================
REDIS_URL=redis://:resolvelo_redis_2024@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=resolvelo_redis_2024

# ==========================================================================
# AUTENTICACIÓN Y SEGURIDAD
# ==========================================================================
# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=resolvelo_jwt_secret_key_2024_super_secure_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Clave para encriptación de datos sensibles (32 bytes)
ENCRYPTION_KEY=resolvelo-secret-key-development-32bytes!!

# Configuración de bcrypt para hash de contraseñas
BCRYPT_ROUNDS=12

# Configuración de rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================================================
# CONFIGURACIÓN DE CORS Y FRONTEND
# ==========================================================================
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:3001

# ==========================================================================
# CONFIGURACIÓN DE ARCHIVOS Y UPLOADS
# ==========================================================================
MAX_FILE_SIZE=10485760  # 10MB en bytes
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Configuración de AWS S3 (para producción)
AWS_REGION=us-east-1
AWS_S3_BUCKET=resolvelo-uploads
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==========================================================================
# CONFIGURACIÓN DE EMAIL
# ==========================================================================
# Para desarrollo (usando MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Para producción (ejemplo con SendGrid)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

EMAIL_FROM=noreply@resolvelo.com
EMAIL_FROM_NAME=ReSolVelo

# ==========================================================================
# CONFIGURACIÓN DE PAGOS (MOCK PARA DESARROLLO)
# ==========================================================================
PAYMENT_GATEWAY_URL=http://localhost:3000/api/mock-payments
PAYMENT_GATEWAY_KEY=mock_key_development
PAYMENT_GATEWAY_SECRET=mock_secret_development

# Para producción (ejemplo con Stripe)
# PAYMENT_GATEWAY_URL=https://api.stripe.com
# PAYMENT_GATEWAY_KEY=pk_live_your_stripe_public_key
