// Schema.prisma optimizado para ReSolVelo
// Generado como Ingeniero de Software Senior especializado en NestJS y Prisma
// Cumple con OWASP Top 10, PCI DSS y mejores prácticas de seguridad

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ÉPICA 1: GESTIÓN DE USUARIOS
// ============================================================================

model Usuario {
  id                      String             @id @default(cuid())
  
  // Información personal básica
  nombre                  String             @db.VarChar(100)
  apellido                String             @db.VarChar(100)
  email                   String             @unique @db.VarChar(255)
  telefono                String?            @db.VarChar(20)
  documentoIdentidad      String             @unique @db.VarChar(12)
  
  // SEGURIDAD POR DISEÑO - Hash + Salt para contraseñas (OWASP Top 10)
  passwordHash            String             @db.VarChar(255)
  passwordSalt            String             @db.VarChar(255)
  
  // Verificación y estados de seguridad
  emailVerificado         Boolean            @default(false)
  telefonoVerificado      Boolean            @default(false)
  estadoVerificacion      EstadoVerificacion @default(PENDIENTE)
  
  // Protección contra ataques de fuerza bruta (OWASP Top 10)
  fechaUltimoAcceso       DateTime?
  intentosFallidos        Int                @default(0)
  bloqueadoHasta          DateTime?
  
  // Gestión de roles y permisos
  rol                     RolUsuario         @default(USUARIO)
  fechaAsignacionRol      DateTime?
  asignadoPor             String?            @db.VarChar(36)
  motivoRol               String?
  permisosSuspendidos     Boolean            @default(false)
  
  // Información de perfil
  fechaNacimiento         DateTime?
  biografia               String?            @db.Text
  avatarUrl               String?            @db.VarChar(500)
  direccion               String?            @db.VarChar(255)
  ciudad                  String?            @db.VarChar(100)
  departamento            String?            @db.VarChar(100)
  codigoPostal            String?            @db.VarChar(10)
  
  // Configuraciones de privacidad y notificaciones
  perfilPublico           Boolean            @default(true)
  notificacionesEmail     Boolean            @default(true)
  notificacionesSms       Boolean            @default(false)
  
  // Sistema de calificaciones
  calificacionPromedio    Decimal?           @db.Decimal(3, 2)
  totalCalificaciones     Int                @default(0)
  
  // Auditoría y control
  fechaCreacion           DateTime           @default(now())
  fechaActualizacion      DateTime           @updatedAt
  ultimoAcceso            DateTime?
  activo                  Boolean            @default(true)
  
  // Tokens de seguridad para verificación y recuperación
  tokenVerificacion       String?            @db.VarChar(255)
  tokenRecuperacion       String?            @db.VarChar(255)
  fechaExpiracionToken    DateTime?
  
  // Campos adicionales para auditoría de seguridad
  ipUltimoAcceso          String?            @db.VarChar(45) // IPv6 compatible
  userAgentUltimoAcceso   String?            @db.VarChar(500)
  sesionesActivas         Int                @default(0)
  
  // Relaciones - ÉPICAS 2, 3, 4
  publicaciones           Publicacion[]
  reservasRealizadas      Reserva[]          @relation("UsuarioReserva")
  reservasRecibidas       Reserva[]          @relation("PropietarioReserva")
  transacciones           Transaccion[]
  calificacionesRecibidas Calificacion[]     @relation("UsuarioCalificado")
  calificacionesDadas     Calificacion[]     @relation("UsuarioCalificador")
  mensajesEnviados        Mensaje[]          @relation("UsuarioEmisor")
  mensajesRecibidos       Mensaje[]          @relation("UsuarioReceptor")
  reportesRecibidos       Reporte[]          @relation("UsuarioReportado")
  reportesRealizados      Reporte[]          @relation("UsuarioReportador")
  disputasComoDemandado   Disputa[]          @relation("UsuarioDemandado")
  disputasComoDemandante  Disputa[]          @relation("UsuarioDemandante")
  evidenciasDisputa       EvidenciaDisputa[] @relation("UsuarioEvidencia")
  mensajesDisputa         MensajeDisputa[]   @relation("AutorMensajeDisputa")
  administrador           Administrador?

  // Índices optimizados para rendimiento y seguridad
  @@index([email])
  @@index([documentoIdentidad])
  @@index([estadoVerificacion])
  @@index([fechaCreacion])
  @@index([calificacionPromedio])
  @@index([activo])
  @@index([bloqueadoHasta])
  @@index([ipUltimoAcceso])
  @@map("usuarios")
}

// ============================================================================
// ÉPICA 2: PUBLICACIÓN DE EQUIPOS
// ============================================================================

model Publicacion {
  id                   String                   @id @default(cuid())
  
  // Información básica del equipo
  titulo               String                   @db.VarChar(200)
  descripcion          String                   @db.Text
  categoria            CategoriaEquipo
  marca                String?                  @db.VarChar(100)
  modelo               String?                  @db.VarChar(100)
  anioFabricacion      Int?
  
  // Precios y condiciones económicas
  precioPorDia         Decimal                  @db.Decimal(10, 2)
  precioPorSemana      Decimal?                 @db.Decimal(10, 2)
  precioPorMes         Decimal?                 @db.Decimal(10, 2)
  deposito             Decimal?                 @db.Decimal(10, 2)
  
  // Disponibilidad y condiciones de alquiler
  disponible           Boolean                  @default(true)
  diasMinimoAlquiler   Int                      @default(1)
  diasMaximoAlquiler   Int?
  
  // Ubicación geográfica
  direccion            String                   @db.VarChar(255)
  ciudad               String                   @db.VarChar(100)
  departamento         String                   @db.VarChar(100)
  codigoPostal         String?                  @db.VarChar(10)
  latitud              Decimal?                 @db.Decimal(10, 8)
  longitud             Decimal?                 @db.Decimal(11, 8)
  
  // Estados y moderación
  estado               EstadoPublicacion        @default(ACTIVA)
  estadoModeracion     EstadoModeracion         @default(PENDIENTE_REVISION)
  fechaModeracion      DateTime?
  moderadoPor          String?                  @db.VarChar(36)
  comentarioModeracion String?                  @db.Text
  
  // Opciones de entrega
  entregaDomicilio     Boolean                  @default(false)
  retiroLocal          Boolean                  @default(true)
  
  // Información adicional del equipo
  estadoEquipo         String                   @db.VarChar(50)
  instrucciones        String?                  @db.Text
  
  // Auditoría y métricas
  fechaCreacion        DateTime                 @default(now())
  fechaActualizacion   DateTime                 @updatedAt
  fechaPublicacion     DateTime?
  fechaVencimiento     DateTime?
  visualizaciones      Int                      @default(0)
  totalReservas        Int                      @default(0)
  calificacionPromedio Decimal?                 @db.Decimal(3, 2)
  totalCalificaciones  Int                      @default(0)
  
  // Validación de entrada para prevenir inyección (OWASP Top 10)
  contenidoValidado    Boolean                  @default(false)
  fechaValidacion      DateTime?
  
  // Relación con propietario
  propietarioId        String
  propietario          Usuario                  @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  
  // Relaciones con otros modelos
  imagenes             ImagenPublicacion[]
  disponibilidades     DisponibilidadFecha[]
  reservas             Reserva[]
  calificaciones       Calificacion[]
  reportes             Reporte[]
  moderaciones         ModeraccionPublicacion[]

  // Índices optimizados
  @@index([propietarioId])
  @@index([categoria])
  @@index([estado])
  @@index([estadoModeracion])
  @@index([ciudad, departamento])
  @@index([precioPorDia])
  @@index([fechaCreacion])
  @@index([calificacionPromedio])
  @@index([disponible])
  @@index([contenidoValidado])
  @@map("publicaciones")
}

// ============================================================================
// ÉPICA 3: GESTIÓN DE RESERVAS
// ============================================================================

model Reserva {
  id                 String         @id @default(cuid())
  
  // Fechas de la reserva
  fechaInicio        DateTime
  fechaFin           DateTime
  fechaCreacion      DateTime       @default(now())
  fechaActualizacion DateTime       @updatedAt
  
  // Estado y flujo de aprobación
  estado             EstadoReserva  @default(PENDIENTE)
  fechaAprobacion    DateTime?
  fechaRechazo       DateTime?
  motivoRechazo      String?        @db.Text
  
  // Información económica
  precioTotal        Decimal        @db.Decimal(10, 2)
  deposito           Decimal?       @db.Decimal(10, 2)
  comisionPlataforma Decimal        @db.Decimal(10, 2)
  
  // Logística de entrega
  tipoEntrega        String         @db.VarChar(50)
  direccionEntrega   String?        @db.VarChar(255)
  fechaEntrega       DateTime?
  fechaDevolucion    DateTime?
  
  // Notas y comunicación
  notasUsuario       String?        @db.Text
  notasPropietario   String?        @db.Text
  notasInternas      String?        @db.Text
  telefonoContacto   String?        @db.VarChar(20)
  
  // Validación y seguridad
  validacionRealizada Boolean       @default(false)
  ipCreacion         String?        @db.VarChar(45)
  
  // Relaciones principales
  usuarioId          String
  publicacionId      String
  propietarioId      String
  
  usuario            Usuario        @relation("UsuarioReserva", fields: [usuarioId], references: [id], onDelete: Cascade)
  publicacion        Publicacion    @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  propietario        Usuario        @relation("PropietarioReserva", fields: [propietarioId], references: [id], onDelete: Cascade)
  
  // Relaciones secundarias
  transacciones      Transaccion[]
  calificaciones     Calificacion[]
  mensajes           Mensaje[]
  disputas           Disputa[]

  // Índices para rendimiento
  @@index([usuarioId])
  @@index([publicacionId])
  @@index([propietarioId])
  @@index([estado])
  @@index([fechaInicio, fechaFin])
  @@index([fechaCreacion])
  @@index([validacionRealizada])
  @@map("reservas")
}

// ============================================================================
// ÉPICA 4: PAGOS Y TRANSACCIONES
// ============================================================================

model Transaccion {
  id                 String            @id @default(cuid())
  
  // Información básica de la transacción
  tipo               TipoTransaccion
  estado             EstadoTransaccion @default(PENDIENTE)
  monto              Decimal           @db.Decimal(10, 2)
  moneda             String            @default("UYU") @db.VarChar(3)
  
  // Información de pago (PCI DSS compliance)
  metodoPago         String?           @db.VarChar(50)
  referenciaExterna  String?           @db.VarChar(255)
  tokenPago          String?           @db.VarChar(255) // Token seguro, no datos de tarjeta
  
  // Fechas del ciclo de vida
  fechaCreacion      DateTime          @default(now())
  fechaProcesamiento DateTime?
  fechaCompletado    DateTime?
  fechaVencimiento   DateTime?
  
  // Información descriptiva
  descripcion        String?           @db.VarChar(500)
  notasInternas      String?           @db.Text
  
  // Cálculos financieros
  comisionPlataforma Decimal?          @db.Decimal(10, 2)
  comisionPasarela   Decimal?          @db.Decimal(10, 2)
  montoNeto          Decimal?          @db.Decimal(10, 2)
  
  // Seguridad y auditoría
  ipTransaccion      String?           @db.VarChar(45)
  hashVerificacion   String?           @db.VarChar(255)
  validacionSeguridad Boolean          @default(false)
  
  // Relaciones
  usuarioId          String
  reservaId          String?
  
  usuario            Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  reserva            Reserva?          @relation(fields: [reservaId], references: [id])

  // Índices para auditoría y rendimiento
  @@index([usuarioId])
  @@index([reservaId])
  @@index([estado])
  @@index([tipo])
  @@index([fechaCreacion])
  @@index([referenciaExterna])
  @@index([validacionSeguridad])
  @@map("transacciones")
}

// ============================================================================
// MODELOS DE SOPORTE Y FUNCIONALIDADES ADICIONALES
// ============================================================================

model Calificacion {
  id                   String      @id @default(cuid())
  puntuacion           Int         @db.SmallInt // 1-5
  comentario           String?     @db.Text
  fechaCreacion        DateTime    @default(now())
  fechaActualizacion   DateTime    @updatedAt
  
  // Validación de contenido
  contenidoValidado    Boolean     @default(false)
  
  // Relaciones
  usuarioCalificadorId String
  usuarioCalificadoId  String
  reservaId            String
  publicacionId        String
  
  usuarioCalificador   Usuario     @relation("UsuarioCalificador", fields: [usuarioCalificadorId], references: [id], onDelete: Cascade)
  usuarioCalificado    Usuario     @relation("UsuarioCalificado", fields: [usuarioCalificadoId], references: [id], onDelete: Cascade)
  reserva              Reserva     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  publicacion          Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioCalificadorId, reservaId])
  @@index([usuarioCalificadorId])
  @@index([usuarioCalificadoId])
  @@index([reservaId])
  @@index([publicacionId])
  @@index([puntuacion])
  @@index([contenidoValidado])
  @@map("calificaciones")
}

model ImagenPublicacion {
  id            String      @id @default(cuid())
  url           String      @db.VarChar(500)
  descripcion   String?     @db.VarChar(255)
  orden         Int         @default(0)
  esPrincipal   Boolean     @default(false)
  fechaCreacion DateTime    @default(now())
  
  // Validación de seguridad para imágenes
  validada      Boolean     @default(false)
  tipoMime      String?     @db.VarChar(50)
  tamanoBytes   Int?
  
  publicacionId String
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@index([publicacionId])
  @@index([orden])
  @@index([validada])
  @@map("imagenes_publicacion")
}

model DisponibilidadFecha {
  id            String      @id @default(cuid())
  fecha         DateTime    @db.Date
  disponible    Boolean     @default(true)
  motivo        String?     @db.VarChar(255)
  publicacionId String
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@unique([publicacionId, fecha])
  @@index([publicacionId])
  @@index([fecha])
  @@index([disponible])
  @@map("disponibilidad_fechas")
}

model Mensaje {
  id            String   @id @default(cuid())
  contenido     String   @db.Text
  fechaCreacion DateTime @default(now())
  leido         Boolean  @default(false)
  fechaLectura  DateTime?
  
  // Validación anti-XSS
  contenidoValidado Boolean @default(false)
  
  emisorId      String
  receptorId    String
  reservaId     String?
  
  emisor        Usuario  @relation("UsuarioEmisor", fields: [emisorId], references: [id], onDelete: Cascade)
  receptor      Usuario  @relation("UsuarioReceptor", fields: [receptorId], references: [id], onDelete: Cascade)
  reserva       Reserva? @relation(fields: [reservaId], references: [id])

  @@index([emisorId])
  @@index([receptorId])
  @@index([reservaId])
  @@index([fechaCreacion])
  @@index([contenidoValidado])
  @@map("mensajes")
}

// ============================================================================
// MODELOS DE ADMINISTRACIÓN Y SEGURIDAD
// ============================================================================

model Administrador {
  id                String                   @id @default(cuid())
  usuarioId         String                   @unique
  fechaAsignacion   DateTime                 @default(now())
  asignadoPor       String?                  @db.VarChar(36)
  activo            Boolean                  @default(true)
  
  usuario           Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permisos          PermisoAdministrador[]
  acciones          AccionAdministrativa[]

  @@map("administradores")
}

model PermisoAdministrador {
  id              String        @id @default(cuid())
  tipo            TipoPermiso
  fechaAsignacion DateTime      @default(now())
  fechaExpiracion DateTime?
  activo          Boolean       @default(true)
  
  administradorId String
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)

  @@index([administradorId])
  @@index([tipo])
  @@map("permisos_administrador")
}

model AccionAdministrativa {
  id              String        @id @default(cuid())
  tipo            TipoAccionAdmin
  descripcion     String        @db.Text
  fechaAccion     DateTime      @default(now())
  ipAccion        String?       @db.VarChar(45)
  
  administradorId String
  usuarioAfectado String?
  
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)

  @@index([administradorId])
  @@index([tipo])
  @@index([fechaAccion])
  @@map("acciones_administrativas")
}

// ============================================================================
// MODELOS DE REPORTES Y DISPUTAS
// ============================================================================

model Reporte {
  id                String           @id @default(cuid())
  motivo            String           @db.VarChar(255)
  descripcion       String           @db.Text
  severidad         SeveridadReporte @default(MEDIA)
  estado            String           @default("PENDIENTE") @db.VarChar(50)
  fechaCreacion     DateTime         @default(now())
  fechaResolucion   DateTime?
  
  reportadorId      String
  reportadoId       String
  publicacionId     String?
  
  reportador        Usuario          @relation("UsuarioReportador", fields: [reportadorId], references: [id], onDelete: Cascade)
  reportado         Usuario          @relation("UsuarioReportado", fields: [reportadoId], references: [id], onDelete: Cascade)
  publicacion       Publicacion?     @relation(fields: [publicacionId], references: [id])

  @@index([reportadorId])
  @@index([reportadoId])
  @@index([publicacionId])
  @@index([estado])
  @@index([severidad])
  @@map("reportes")
}

model Disputa {
  id                String             @id @default(cuid())
  tipo              TipoDisputa
  estado            EstadoDisputa      @default(ABIERTA)
  descripcion       String             @db.Text
  fechaCreacion     DateTime           @default(now())
  fechaResolucion   DateTime?
  resolucion        String?            @db.Text
  
  demandanteId      String
  demandadoId       String
  reservaId         String
  
  demandante        Usuario            @relation("UsuarioDemandante", fields: [demandanteId], references: [id], onDelete: Cascade)
  demandado         Usuario            @relation("UsuarioDemandado", fields: [demandadoId], references: [id], onDelete: Cascade)
  reserva           Reserva            @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  
  mensajes          MensajeDisputa[]
  evidencias        EvidenciaDisputa[]

  @@index([demandanteId])
  @@index([demandadoId])
  @@index([reservaId])
  @@index([estado])
  @@index([tipo])
  @@map("disputas")
}

model MensajeDisputa {
  id            String   @id @default(cuid())
  contenido     String   @db.Text
  fechaCreacion DateTime @default(now())
  
  autorId       String
  disputaId     String
  
  autor         Usuario  @relation("AutorMensajeDisputa", fields: [autorId], references: [id], onDelete: Cascade)
  disputa       Disputa  @relation(fields: [disputaId], references: [id], onDelete: Cascade)

  @@index([autorId])
  @@index([disputaId])
  @@index([fechaCreacion])
  @@map("mensajes_disputa")
}

model EvidenciaDisputa {
  id            String   @id @default(cuid())
  tipo          String   @db.VarChar(50)
  url           String   @db.VarChar(500)
  descripcion   String?  @db.Text
  fechaCreacion DateTime @default(now())
  
  usuarioId     String
  disputaId     String
  
  usuario       Usuario  @relation("UsuarioEvidencia", fields: [usuarioId], references: [id], onDelete: Cascade)
  disputa       Disputa  @relation(fields: [disputaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([disputaId])
  @@map("evidencias_disputa")
}

model ModeraccionPublicacion {
  id              String      @id @default(cuid())
  accion          String      @db.VarChar(100)
  motivo          String      @db.Text
  fechaAccion     DateTime    @default(now())
  
  publicacionId   String
  moderadorId     String?
  
  publicacion     Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@index([publicacionId])
  @@index([moderadorId])
  @@index([fechaAccion])
  @@map("moderaciones_publicacion")
}

// ============================================================================
// MODELO DE ESTADÍSTICAS DEL SISTEMA
// ============================================================================

model EstadisticaSistema {
  id                    String   @id @default(cuid())
  fecha                 DateTime @db.Date
  usuariosRegistrados   Int      @default(0)
  publicacionesActivas  Int      @default(0)
  reservasCompletadas   Int      @default(0)
  transaccionesTotales  Decimal  @default(0) @db.Decimal(15, 2)
  fechaActualizacion    DateTime @updatedAt

  @@unique([fecha])
  @@index([fecha])
  @@map("estadisticas_sistema")
}

// ============================================================================
// ENUMERACIONES
// ============================================================================

enum EstadoVerificacion {
  PENDIENTE
  VERIFICADO
  RECHAZADO
  SUSPENDIDO
}

enum RolUsuario {
  USUARIO
  ADMINISTRADOR
  MODERADOR
  SUPER_ADMIN
}

enum EstadoPublicacion {
  BORRADOR
  ACTIVA
  PAUSADA
  ELIMINADA
  SUSPENDIDA
}

enum EstadoModeracion {
  PENDIENTE_REVISION
  APROBADA
  RECHAZADA
  REQUIERE_CAMBIOS
}

enum EstadoReserva {
  PENDIENTE
  APROBADA
  RECHAZADA
  CONFIRMADA
  EN_CURSO
  COMPLETADA
  CANCELADA_USUARIO
  CANCELADA_PROPIETARIO
  DISPUTADA
}

enum EstadoTransaccion {
  PENDIENTE
  PROCESANDO
  COMPLETADA
  FALLIDA
  CANCELADA
  REEMBOLSADA
}

enum TipoTransaccion {
  PAGO_RESERVA
  DEPOSITO
  REEMBOLSO
  COMISION
  PENALIZACION
}

enum CategoriaEquipo {
  GUITARRAS
  BAJOS
  BATERIAS
  TECLADOS
  AMPLIFICADORES
  MICROFONOS
  AUDIO_PROFESIONAL
  EFECTOS
  PERCUSION
  VIENTOS
  CUERDAS
  ACCESORIOS
  OTROS
}

enum TipoPermiso {
  GESTIONAR_USUARIOS
  MODERAR_PUBLICACIONES
  RESOLVER_DISPUTAS
  VER_ESTADISTICAS
  GESTIONAR_TRANSACCIONES
  ACCESO_TOTAL
}

enum TipoAccionAdmin {
  CREAR_USUARIO
  SUSPENDER_USUARIO
  ELIMINAR_PUBLICACION
  RESOLVER_DISPUTA
  PROCESAR_REEMBOLSO
  CAMBIAR_PERMISOS
}

enum TipoDisputa {
  EQUIPO_DANADO
  NO_ENTREGA
  DESCRIPCION_INCORRECTA
  PROBLEMA_PAGO
  COMPORTAMIENTO_INADECUADO
  OTROS
}

enum EstadoDisputa {
  ABIERTA
  EN_REVISION
  RESUELTA
  CERRADA
}

enum SeveridadReporte {
  BAJA
  MEDIA
  ALTA
  CRITICA
}