{
  "name": "resolvelo-backend",
  "version": "1.0.0",
  "description": "Backend API para ReSolVelo - Plataforma de alquiler de equipos musicales",
  "main": "dist2/main.js",
  "license": "MIT",
  "scripts": {
    "start": "node dist2/main.js",
    "start:dist": "node dist2/main.js",
    "start:prod": "node dist2/main.js",
    "start:dev": "ts-node-dev --clear --respawn --transpile-only src/main.ts",
    "start:dev:3006": "set HOST=127.0.0.1 && set PORT=3006 && set FRONTEND_URL=http://127.0.0.1:5174 && set MP_SUCCESS_URL=http://127.0.0.1:5174/pago-exitoso && set MP_FAILURE_URL=http://127.0.0.1:5174/pago-error && set MP_PENDING_URL=http://127.0.0.1:5174/pago-exitoso && set MP_NOTIFICATION_URL=https://example.com/webhook && ts-node-dev --clear --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest.config.js --runInBand",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.940.0",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.7",
    "@prisma/client": "^5.17.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "mercadopago": "^2.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.7.2",
    "prisma": "^5.17.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
